<%- include('partials/header') %>
<section class="page-heading"><p class="eyebrow"><%= page === 'admin' ? 'PANEL DE ADMINISTRACIÓN' : 'TU ESPACIO PERSONAL' %></p><h1 id="welcome"><%= title %></h1><p class="lead"><%= page === 'admin' ? 'Consulta los usuarios registrados y revisa sus datos.' : 'Bienvenido, aquí están tus datos.' %></p></section>
<div id="message" class="notice" role="status" hidden></div>
<section data-protected hidden>
<% if (page === 'admin') { %>
  <div class="stats"><div class="panel"><p class="eyebrow">CUENTAS REGISTRADAS</p><strong id="user-count" class="stat-number">0</strong></div><div class="panel"><p class="eyebrow">TU ROL</p><strong class="stat-label">Administrador</strong><p class="muted">Acceso al directorio de usuarios</p></div></div>
  <div class="panel"><div class="section-top"><h2>Directorio de usuarios</h2><span class="chip">Usuarios y administradores</span></div><div class="table-wrap"><table class="highlight"><thead><tr><th>Nombre</th><th>Correo</th><th>Roles</th><th>Registro</th><th>Detalle</th></tr></thead><tbody id="users-table"></tbody></table></div><div class="table-pagination"><p id="page-info" class="muted" aria-live="polite"></p><div><button id="previous-page" class="btn-flat" type="button">Anterior</button><button id="next-page" class="btn-flat" type="button">Siguiente</button></div></div></div>
  <div id="user-modal" class="modal"><div class="modal-content"><p class="eyebrow">INFORMACIÓN DEL USUARIO</p><h2 id="detail-name"></h2><dl id="user-detail"></dl></div><div class="modal-footer"><button class="modal-close btn-flat">Cerrar</button></div></div>
<% } else { %>
  <div class="dashboard-grid"><div class="panel welcome-card"><span class="chip">Cuenta activa</span><h2>Un perfil que habla de ti.</h2><p>Actualiza tu información personal y mantén tu cuenta al día.</p><a href="/profile" class="btn waves-effect">Editar mi perfil</a></div><div class="panel"><p class="eyebrow">MIS DATOS</p><dl id="user-summary"></dl></div></div>
<% } %>
</section>
<%- include('partials/footer') %>
